FLOW: Flow Analysis 1
  SOLUTION UNITS:
    Angle Units = [rad]
    Length Units = [m]
    Mass Units = [kg]
    Solid Angle Units = [sr]
    Temperature Units = [K]
    Time Units = [s]
  END
  ANALYSIS TYPE:
    Option = Steady State
    EXTERNAL SOLVER COUPLING:
      Option = None
    END
  END
  DOMAIN: Default Domain
    Coord Frame = Coord 0
    Domain Type = Fluid
    Location = FLUID
    BOUNDARY: BLADE
      Boundary Type = WALL
      Location = BLADE.1
      BOUNDARY CONDITIONS:
        HEAT TRANSFER:
          Fixed Temperature = 300 [K]
          Option = Fixed Temperature
        END
        MASS AND MOMENTUM:
          Option = No Slip Wall
        END
        WALL ROUGHNESS:
          Option = Smooth Wall
        END
      END
    END
    BOUNDARY: FRONTBACK
      Boundary Type = SYMMETRY
      Location = SYMM2,SYMM1
    END
    BOUNDARY: INLET
      Boundary Type = INLET
      Location = INLET
      BOUNDARY CONDITIONS:
        FLOW DIRECTION:
          Option = Cartesian Components
          Unit Vector X Component = 1
          Unit Vector Y Component = 0
          Unit Vector Z Component = 0
        END
        FLOW REGIME:
          Option = Subsonic
        END
        HEAT TRANSFER:
          Option = Total Temperature
          Total Temperature = 420 [K]
        END
        MASS AND MOMENTUM:
          Option = Total Pressure
          Relative Pressure = 330860 [Pa]
        END
        TURBULENCE:
          Eddy Viscosity Ratio = 10.
          Fractional Intensity = 0.06
          Option = Intensity and Eddy Viscosity Ratio
        END
      END
    END
    BOUNDARY: OUTLET
      Boundary Type = OUTLET
      Location = OUTLET
      BOUNDARY CONDITIONS:
        FLOW REGIME:
          Option = Subsonic
        END
        MASS AND MOMENTUM:
          Option = Average Static Pressure
          Pressure Profile Blend = 0.05
          Relative Pressure = 154960 [Pa]
        END
        PRESSURE AVERAGING:
          Option = Average Over Whole Outlet
        END
      END
    END
    BOUNDARY: PERIODIC Side 1
      Boundary Type = INTERFACE
      Location = PER_UPP
      BOUNDARY CONDITIONS:
        HEAT TRANSFER:
          Option = Conservative Interface Flux
        END
        MASS AND MOMENTUM:
          Option = Conservative Interface Flux
        END
        TURBULENCE:
          Option = Conservative Interface Flux
        END
      END
    END
    BOUNDARY: PERIODIC Side 2
      Boundary Type = INTERFACE
      Location = PER_LOW
      BOUNDARY CONDITIONS:
        HEAT TRANSFER:
          Option = Conservative Interface Flux
        END
        MASS AND MOMENTUM:
          Option = Conservative Interface Flux
        END
        TURBULENCE:
          Option = Conservative Interface Flux
        END
      END
    END
    DOMAIN MODELS:
